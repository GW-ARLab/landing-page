# ==========================================
# CẤU HÌNH ARL CMS BACKEND (.env)
# ==========================================

# 1. Chế độ hoạt động (development / production)
# - development: Dùng tài khoản giả lập X-ARL-User, dữ liệu local trong cms-data/
# - production: Bắt buộc đăng nhập Google OAuth, kết nối Sheets & Drive thật
ARL_MODE=development

# 2. Host và Port nội bộ (sau reverse proxy / Cloudflare Tunnel)
ARL_HOST=127.0.0.1
ARL_PORT=8787

# 3. Domain công khai (BẮT BUỘC có https://, KHÔNG có dấu / ở cuối)
ARL_SITE_URL=https://yourdomain.com

# 4. Thư mục lưu trữ dữ liệu (SQLite, releases, candidates, media)
ARL_DATA_DIR=./cms-data
ARL_BACKUP_DIR=./cms-backups

# ==========================================
# CẤU HÌNH GOOGLE INTEGRATION (Khi chạy production)
# ==========================================
# Đường dẫn tuyệt đối file Service Account Google Cloud (đã giải nén vào secrets/service-account.json)
ARL_GOOGLE_CREDENTIALS=/etc/arl-cms/secrets/service-account.json

# ID của 3 Google Sheets chính thức (đã kiểm tra và khớp 100%)
ARL_CONTENT_SHEET_ID=1tYbCnkU7o3AQ9Qvkgs5BbF6Mxyz22U2MEE2-6ovkjU8
ARL_INQUIRIES_SHEET_ID=1d6e5zIyp0DzxB4L9DW4ZNYz8z1c8NIhamRzVEBzNxzk
ARL_OPERATIONS_SHEET_ID=1J5_U5x8eg1VXxMlmWs0yZ9Ce2b_JKiGn8bh1UBK5_AA

# Google OAuth Web Client ID (dành cho Sign-In CMS)
ARL_GOOGLE_CLIENT_ID=368533702412-joa46jkpq8suh5prmqtac3cog9u5jtdm.apps.googleusercontent.com

# File phân quyền email admin/editor/publisher/inquiries
ARL_ROLE_EMAIL_MAP_FILE=/var/www/landing-page/cms-data/ARL_Role_Email_Map.local.json

# Cấu hình tải Media lên Google Drive của Zally
ARL_DRIVE_OWNER_EMAIL=zally.aihoc@gmail.com
ARL_DRIVE_OAUTH_CLIENT_FILE=/etc/arl-cms/secrets/drive-client.json
ARL_DRIVE_TOKEN_FILE=/etc/arl-cms/secrets/drive-token.json

# Cờ cho phép ghi vào Sheet và tải media vào Drive (Chỉ bật sau khi sao lưu và kiểm thử)
ARL_GOOGLE_CONTENT_WRITE_ENABLED=false
ARL_DRIVE_MEDIA_WRITE_ENABLED=false
