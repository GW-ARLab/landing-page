{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir cms-ssr",
    "preview": "vite preview",
    "format": "oxfmt",
    "cms:dev": "node cms/server.mjs",
    "cms:check": "pnpm run build && node --test cms/tests/*.test.mjs",
    "cms:check-official-sheets": "node cms/check-official-sheets.mjs",
    "cms:backup": "node cms/backup.mjs",
    "cms:bootstrap-google": "node cms/bootstrap-google.mjs",
    "cms:import-legal-drafts": "node cms/import-legal-drafts.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
