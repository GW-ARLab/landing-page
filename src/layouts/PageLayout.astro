---
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  breadcrumbs?: Array<{ label: string; href: string; i18nKey?: string }>;
}

const { title, description, ogImage, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description={description} ogImage={ogImage}>
  <slot name="head" slot="head" />

  {breadcrumbs && breadcrumbs.length > 0 && (
    <div class="border-b border-slate-200 bg-slate-50">
      <div class="container-wide py-3">
        <nav aria-label="Breadcrumb">
          <ol class="flex items-center gap-2 text-sm" role="list">
            <li>
              <a href="/" class="text-slate-500 hover:text-electric-600 transition-colors" data-i18n="page404.cta.home">Home</a>
            </li>
            {breadcrumbs.map((crumb, i) => (
              <li class="flex items-center gap-2">
                <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
                {i === breadcrumbs.length - 1 ? (
                  <span class="text-slate-800 font-medium" aria-current="page" data-i18n={crumb.i18nKey}>{crumb.label}</span>
                ) : (
                  <a href={crumb.href} class="text-slate-500 hover:text-electric-600 transition-colors" data-i18n={crumb.i18nKey}>{crumb.label}</a>
                )}
              </li>
            ))}
          </ol>
        </nav>
      </div>
    </div>
  )}

  <slot />
</BaseLayout>
