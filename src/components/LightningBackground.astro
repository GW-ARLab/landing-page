---
// Subtle ambient particle background — light theme, professional
---

<canvas
  id="particle-canvas"
  class="fixed inset-0 w-full h-full pointer-events-none select-none"
  style="z-index: -1;"
  aria-hidden="true"
></canvas>

<script>
(function () {
  const canvas = /** @type {HTMLCanvasElement} */ (document.getElementById('particle-canvas'));
  if (!canvas) return;
  const ctx = /** @type {CanvasRenderingContext2D} */ (canvas.getContext('2d'));

  /**
   * @param {number} x @param {number} y
   */
  function Particle(x, y) {
    this.x     = x;
    this.y     = y;
    this.r     = 0.8 + Math.random() * 1.5;
    this.vx    = (Math.random() - 0.5) * 0.06;
    this.vy    = (Math.random() - 0.5) * 0.06;
    this.alpha = 0.04 + Math.random() * 0.10;
    this.phase = Math.random() * Math.PI * 2;
    this.phaseSpd = 0.002 + Math.random() * 0.003;
  }

  /** @type {InstanceType<typeof Particle>[]} */
  let particles = [];

  function initParticles() {
    canvas.width  = window.innerWidth;
    canvas.height = window.innerHeight;
    particles = [];
    const count = Math.min(Math.floor((canvas.width * canvas.height) / 6000), 300);
    for (let i = 0; i < count; i++) {
      particles.push(new Particle(
        Math.random() * canvas.width,
        Math.random() * canvas.height
      ));
    }
  }

  window.addEventListener('resize', initParticles, { passive: true });
  initParticles();

  function frame() {
    // White background
    ctx.fillStyle = '#FFFFFF';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Very faint blue tint at top — adds depth without being distracting
    const glow = ctx.createRadialGradient(
      canvas.width * 0.5, 0, 0,
      canvas.width * 0.5, 0, canvas.height * 0.6
    );
    glow.addColorStop(0,   'rgba(37, 99, 235, 0.04)');
    glow.addColorStop(1,   'rgba(0, 0, 0, 0)');
    ctx.fillStyle = glow;
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    // Particles — slate-300 on white, very faint
    for (const p of particles) {
      p.x += p.vx;
      p.y += p.vy;
      if (p.x < 0) p.x = canvas.width;
      if (p.x > canvas.width) p.x = 0;
      if (p.y < 0) p.y = canvas.height;
      if (p.y > canvas.height) p.y = 0;

      p.phase += p.phaseSpd;
      const alpha = p.alpha * (0.6 + 0.4 * Math.sin(p.phase));

      ctx.globalAlpha = alpha;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fillStyle = '#94A3B8'; // slate-400
      ctx.fill();
    }

    ctx.globalAlpha = 1;
    requestAnimationFrame(frame);
  }

  requestAnimationFrame(frame);
})();
</script>
