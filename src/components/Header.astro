---
import { navLinks, siteConfig } from '@/lib/site';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
const pathname = Astro.url.pathname;

const navI18nKey: Record<string, string> = {
  'Products': 'nav.products',
  'Solutions': 'nav.solutions',
  'Research': 'nav.research',
  'About': 'nav.about',
  'Contact': 'nav.contact',
  'All Products': 'nav.products.all',
  'Workflow Agent': 'nav.products.workflow',
  '3D Printing': 'nav.products.printing',
  'Autonomous Robot Vehicle': 'nav.products.robot',
  'Desktop & Web Automation': 'nav.solutions.desktop',
  'Robotics Automation': 'nav.solutions.robotics',
  'Zalo AI Agents': 'nav.solutions.zalo',
  'Research Areas': 'nav.research.areas',
  'Publications': 'nav.research.publications',
  'Open Source': 'nav.research.opensource',
};
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  data-scroll="false"
>
  <div class="container-wide">
    <nav
      class="flex items-center justify-between h-16 lg:h-18"
      aria-label="Main navigation"
    >
      <!-- Logo & Collaboration Group -->
      <div class="flex items-center gap-3">
        <!-- Logo ARL -->
        <a
          href="/"
          class="flex items-center gap-2.5 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-electric-400 rounded-md"
          aria-label="Applied Robotics Lab — Home"
        >
          <!-- Logo mark -->
          <div class="relative w-8 h-8 flex-shrink-0">
            <div class="absolute inset-0 bg-electric-gradient rounded-lg rotate-6 opacity-80 group-hover:rotate-12 transition-transform duration-300"></div>
            <div class="absolute inset-0 bg-navy-800 rounded-md flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <circle cx="9" cy="9" r="3" fill="#3B82F6"/>
                <path d="M9 2v2M9 14v2M2 9h2M14 9h2M4.22 4.22l1.42 1.42M12.36 12.36l1.42 1.42M4.22 13.78l1.42-1.42M12.36 5.64l1.42-1.42" stroke="#06B6D4" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
          </div>
          <span class="font-bold text-slate-900 text-sm lg:text-base hidden sm:block">
            Applied <span class="text-gradient-electric">Robotics</span> Lab
          </span>
          <span class="font-bold text-slate-900 text-base sm:hidden">ARL</span>
        </a>

        <!-- Divider line -->
        <div class="h-5 w-px bg-slate-200" aria-hidden="true"></div>

        <!-- Greenwich Logo -->
        <a
          href="https://greenwich.edu.vn"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-electric-400 rounded-md"
          aria-label="University of Greenwich Vietnam (opens in a new tab)"
          data-i18n-aria="nav.greenwich.label"
        >
          <img
            src="/images/greenwich-logo.png"
            alt="University of Greenwich Logo"
            data-i18n-alt="nav.greenwich.logo"
            class="h-6 sm:h-7 lg:h-8 w-auto object-contain hover:opacity-85 transition-opacity"
          />
        </a>
      </div>


      <!-- Desktop Nav -->
      <ul class="hidden lg:flex items-center gap-1" role="list">
        {navLinks.map((link) => (
          <li class="relative group" data-nav-item>
            {link.children ? (
              <>
                <button
                  class:list={[
                    'flex items-center gap-1 px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-200',
                    pathname.startsWith(link.href)
                      ? 'text-electric-600 bg-electric-50'
                      : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100',
                  ]}
                  aria-expanded="false"
                  aria-haspopup="true"
                  data-dropdown-trigger
                  data-i18n={navI18nKey[link.label]}
                >
                  {link.label}
                  <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <!-- Dropdown -->
                <div
                  class="absolute top-full left-0 pt-2 w-56 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 translate-y-1 group-hover:translate-y-0"
                  role="menu"
                >
                  <div class="bg-white border border-slate-200 rounded-xl shadow-lg shadow-slate-200/60 p-1.5">
                    {link.children.map((child) => (
                      <a
                        href={child.href}
                        class:list={[
                          'flex items-center px-3 py-2 rounded-lg text-sm transition-colors duration-150',
                          pathname === child.href
                            ? 'text-electric-600 bg-electric-50'
                            : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100',
                        ]}
                        role="menuitem"
                        data-i18n={navI18nKey[child.label]}
                      >
                        {child.label}
                      </a>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <a
                href={link.href}
                class:list={[
                  'px-3 py-2 rounded-lg text-sm font-medium transition-colors duration-200',
                  pathname === link.href
                    ? 'text-electric-600 bg-electric-50'
                    : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100',
                ]}
                aria-current={pathname === link.href ? 'page' : undefined}
                data-i18n={navI18nKey[link.label]}
              >
                {link.label}
              </a>
            )}
          </li>
        ))}
      </ul>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-2">
        <LanguageSwitcher />
        <a href="/contact?type=request-demo" class="btn-outline-cyan btn-sm" data-i18n="nav.cta.demo">
          Đặt lịch Demo
        </a>
        <a href="/products" class="btn-primary btn-sm" data-i18n="nav.cta.products">
          Khám phá Sản phẩm
        </a>
      </div>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open navigation menu"
      >
        <svg id="menu-icon-open" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-slate-200 bg-white/95 backdrop-blur-md"
    role="dialog"
    aria-label="Navigation menu"
    aria-modal="false"
  >
    <div class="container-wide py-4 space-y-1">
      {navLinks.map((link) => (
        <div>
          {link.children ? (
            <details class="group/detail">
              <summary class:list={[
                'flex items-center justify-between px-3 py-2.5 rounded-lg text-sm font-medium cursor-pointer list-none',
                pathname.startsWith(link.href)
                  ? 'text-electric-600 bg-electric-50'
                  : 'text-slate-700 hover:text-slate-900 hover:bg-slate-100',
              ]}
              data-i18n={navI18nKey[link.label]}
              >
                {link.label}
                <svg class="w-4 h-4 transition-transform duration-200 group-open/detail:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="ml-3 mt-1 space-y-0.5 border-l border-slate-200 pl-3">
                {link.children.map((child) => (
                  <a
                    href={child.href}
                    class:list={[
                      'block px-3 py-2 rounded-lg text-sm transition-colors',
                      pathname === child.href
                        ? 'text-electric-600'
                        : 'text-slate-500 hover:text-slate-900',
                    ]}
                    data-i18n={navI18nKey[child.label]}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </details>
          ) : (
            <a
              href={link.href}
              class:list={[
                'block px-3 py-2.5 rounded-lg text-sm font-medium transition-colors',
                pathname === link.href
                  ? 'text-electric-600 bg-electric-50'
                  : 'text-slate-700 hover:text-slate-900 hover:bg-slate-100',
              ]}
              aria-current={pathname === link.href ? 'page' : undefined}
              data-i18n={navI18nKey[link.label]}
            >
              {link.label}
            </a>
          )}
        </div>
      ))}

      <div class="pt-3 pb-1 flex flex-col gap-2 border-t border-slate-200">
        <a href="/contact?type=request-demo" class="btn-outline-cyan w-full justify-center" data-i18n="nav.cta.demo">
          Đặt lịch Demo
        </a>
        <a href="/products" class="btn-primary w-full justify-center" data-i18n="nav.cta.products">
          Khám phá Sản phẩm
        </a>
        <div class="flex justify-center pt-1">
          <LanguageSwitcher />
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Spacer for fixed header -->
<div class="h-16 lg:h-18" aria-hidden="true"></div>

<script>
  // Header scroll effect
  const header = document.getElementById('site-header');
  function updateHeader() {
    if (!header) return;
    const scrolled = window.scrollY > 20;
    header.setAttribute('data-scroll', String(scrolled));
    if (scrolled) {
      header.classList.add('bg-white/95', 'backdrop-blur-md', 'border-b', 'border-slate-200', 'shadow-sm', 'shadow-slate-100');
    } else {
      header.classList.remove('bg-white/95', 'backdrop-blur-md', 'border-b', 'border-slate-200', 'shadow-sm', 'shadow-slate-100');
    }
  }
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  // Mobile menu toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    mobileBtn?.setAttribute('aria-expanded', 'true');
    iconOpen?.classList.add('hidden');
    iconClose?.classList.remove('hidden');
    mobileMenu?.querySelector('a')?.focus();
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    mobileBtn?.setAttribute('aria-expanded', 'false');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  mobileBtn?.addEventListener('click', () => {
    const isOpen = mobileBtn.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMenu();
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (
      mobileMenu &&
      !mobileMenu.classList.contains('hidden') &&
      !mobileMenu.contains(e.target as Node) &&
      !mobileBtn?.contains(e.target as Node)
    ) {
      closeMenu();
    }
  });
</script>
