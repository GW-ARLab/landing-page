---
import type { Product } from '@/lib/content';
import { productSlug } from '@/lib/content';

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<section class="section bg-slate-50 relative overflow-hidden" id="workflow-agent">
  <div class="glow-blue w-[700px] h-[700px] -bottom-40 -left-20 opacity-15" aria-hidden="true"></div>
  <div class="glow-spark w-[400px] h-[400px] top-20 right-0 opacity-10" aria-hidden="true"></div>

  <!-- Divider -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Left: Content -->
      <div>
        <div class="inline-flex items-center gap-2 mb-4">
          <span class="badge-beta">Beta</span>
          <span class="text-xs text-slate-400 uppercase tracking-widest font-semibold" data-i18n="workflow.flagship">Sản phẩm Chủ lực</span>
        </div>

        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black leading-tight mb-5" data-i18n-html="workflow.h2.html">
          Gặp gỡ <span class="text-gradient-spark">Workflow Agent</span>
        </h2>

        <p class="text-lg text-slate-500 leading-relaxed mb-8" data-i18n="workflow.desc">
          Mô tả những gì bạn muốn làm — Workflow Agent lên kế hoạch, thực thi và báo cáo lại. Tác vụ desktop, tự động hóa trình duyệt, thao tác tệp. Tất cả chạy cục bộ trên máy của bạn.
        </p>

        <!-- Feature list -->
        <ul class="space-y-4 mb-8">
          {product.data.features.slice(0, 4).map((feature) => (
            <li class="flex items-start gap-3">
              <div class="mt-0.5 w-5 h-5 rounded-full bg-electric-100 border border-electric-300 flex items-center justify-center flex-shrink-0">
                <svg class="w-3 h-3 text-electric-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <span class="font-semibold text-slate-800 text-sm">{feature.title}</span>
                <span class="text-slate-500 text-sm"> — {feature.description}</span>
              </div>
            </li>
          ))}
        </ul>

        <!-- Platforms -->
        <div class="flex items-center gap-3 mb-8">
          <span class="text-xs text-slate-400 uppercase tracking-wider" data-i18n="workflow.runs.on">Chạy trên</span>
          {product.data.platforms.map((p) => (
            <span class="inline-flex items-center gap-1.5 text-sm text-slate-600 px-3 py-1 rounded-lg bg-white border border-slate-200">
              <svg class="w-3.5 h-3.5 text-electric-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <rect x="2" y="3" width="20" height="14" rx="2" stroke-width="1.5"/>
                <path d="M8 21h8M12 17v4" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              {p}
            </span>
          ))}  
        </div>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4">
          <a href={product.data.primaryCta?.url ?? '/contact?product=workflow-agent'} class="btn-spark btn-lg" data-i18n="workflow.cta.access">
            Đăng ký Truy cập Sớm
          </a>
          <a href={`/products/${productSlug(product)}`} class="btn-outline btn-lg" data-i18n="workflow.cta.details">
            Chi tiết Sản phẩm
          </a>
        </div>
      </div>

      <!-- Right: Interactive demo mockup -->
      <div class="relative" aria-label="Workflow Agent interface preview">
        <div class="absolute -inset-8 bg-spark-500/5 rounded-3xl blur-2xl" aria-hidden="true"></div>

        <div class="relative bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-lg">
          <!-- Chat interface header -->
          <div class="flex items-center justify-between px-4 py-3 bg-slate-50 border-b border-slate-200">
            <div class="flex items-center gap-2">
              <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
              <span class="text-xs text-slate-600 font-medium" data-i18n="workflow.chat.active">Workflow Agent — Đang hoạt động</span>
            </div>
            <div class="flex items-center gap-2 text-xs text-slate-400">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
              <span data-i18n="workflow.chat.local">Cục bộ &amp; Riêng tư</span>
            </div>
          </div>

          <!-- Chat messages -->
          <div class="p-4 space-y-4 min-h-[200px]">
            <!-- User message -->
            <div class="flex justify-end">
              <div class="bg-electric-600 rounded-2xl rounded-tr-sm px-4 py-2.5 max-w-xs">
                <p class="text-sm text-white" data-i18n="workflow.chat.user">Sắp xếp thư mục Downloads theo loại tệp và xóa các tệp trùng lặp</p>
              </div>
            </div>

            <!-- Agent response -->
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-electric-gradient flex items-center justify-center flex-shrink-0 text-xs font-bold text-white">A</div>
              <div class="bg-slate-50 border border-slate-200 rounded-2xl rounded-tl-sm px-4 py-2.5 max-w-xs">
                <p class="text-sm text-slate-700 mb-2" data-i18n="workflow.chat.plan">Được rồi! Đây là kế hoạch của tôi:</p>
                <ol class="text-xs text-slate-500 space-y-1 list-decimal list-inside">
                  <li data-i18n="workflow.chat.step1">Quét thư mục Downloads</li>
                  <li data-i18n="workflow.chat.step2">Phân nhóm theo phần mở rộng tệp</li>
                  <li data-i18n="workflow.chat.step3">Phát hiện &amp; đánh dấu tệp trùng</li>
                  <li data-i18n="workflow.chat.step4">Di chuyển vào thư mục có tổ chức</li>
                </ol>
              </div>
            </div>

            <!-- Progress -->
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-full bg-electric-gradient flex items-center justify-center flex-shrink-0 text-xs font-bold text-white">A</div>
              <div class="bg-green-50 border border-green-200 rounded-2xl rounded-tl-sm px-4 py-2.5">
                <div class="flex items-center gap-2 text-xs text-green-700">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                  <span data-i18n="workflow.chat.done">Xong! Đã di chuyển 147 tệp, xóa 23 tệp trùng lặp.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Input bar -->
          <div class="px-4 pb-4">
            <div class="flex items-center gap-2 bg-slate-100 border border-slate-200 rounded-xl px-3 py-2">
              <span class="text-xs text-slate-400 flex-1" data-i18n="workflow.chat.placeholder">Nhập nhiệm vụ...</span>
              <button class="p-1 rounded-lg bg-electric-600 hover:bg-electric-700 transition-colors" aria-label="Send task" tabindex="-1">
                <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
