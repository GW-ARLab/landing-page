---
// Hero Section
---

<section class="relative min-h-[92vh] flex items-center overflow-hidden">
  <!-- Background elements -->
  <div class="absolute inset-0 bg-grid-pattern opacity-60" aria-hidden="true"></div>
  <div class="glow-blue w-[600px] h-[600px] -top-40 -left-40 opacity-40" aria-hidden="true"></div>
  <div class="glow-spark w-[400px] h-[400px] top-1/3 right-0 opacity-30" aria-hidden="true"></div>

  <!-- Animated circuit lines -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <svg class="absolute top-0 right-0 w-1/2 h-full opacity-5" viewBox="0 0 400 600" fill="none">
      <path d="M400 0 L300 100 L300 200 L200 200 L200 300 L100 300 L100 400 L0 400" stroke="#2563EB" stroke-width="1" fill="none"/>
      <path d="M400 100 L350 150 L350 250 L250 250 L250 350 L150 350" stroke="#3B82F6" stroke-width="0.5" fill="none"/>
      <circle cx="300" cy="100" r="3" fill="#2563EB"/>
      <circle cx="200" cy="200" r="3" fill="#2563EB"/>
      <circle cx="100" cy="300" r="3" fill="#3B82F6"/>
      <circle cx="250" cy="250" r="2" fill="#3B82F6"/>
    </svg>
  </div>

  <div class="container-wide relative z-10 py-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Content -->
      <div>
        <!-- Label -->
        <div class="section-label mb-6 animate-fade-in" style="opacity:0;animation-fill-mode:forwards;animation-delay:0.1s">
          <span data-i18n="hero.label">Applied Robotics Lab</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black leading-[1.08] mb-6 animate-fade-up" style="opacity:0;animation-fill-mode:forwards;animation-delay:0.2s">
          <span data-i18n="hero.h1.prefix">Xây dựng hệ thống</span><br />
          <span data-i18n="hero.h1.middle">thông minh</span><br />
          <span class="text-gradient-hero" data-i18n="hero.h1.gradient">hoạt động trong thế giới thực.</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-slate-500 leading-relaxed mb-8 max-w-lg animate-fade-up" style="opacity:0;animation-fill-mode:forwards;animation-delay:0.35s" data-i18n="hero.sub">
          Chúng tôi phát triển AI workflow agent, robot tự hành và giải pháp tự động hóa — từ tự động hóa desktop đến hệ thống robot vật lý.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-4 animate-fade-up" style="opacity:0;animation-fill-mode:forwards;animation-delay:0.5s">
          <a href="/products" class="btn-primary btn-lg group">
            <span data-i18n="hero.cta.explore">Khám phá Sản phẩm</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          </a>
          <a href="/contact?type=request-demo" class="btn-outline-cyan btn-lg" data-i18n="hero.cta.demo">
            Đặt lịch Demo
          </a>
        </div>

        <!-- Stats row -->
        <div class="mt-12 flex flex-wrap gap-8 animate-fade-up" style="opacity:0;animation-fill-mode:forwards;animation-delay:0.65s">
          <div>
            <div class="text-2xl font-bold text-slate-900">3+</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider" data-i18n="hero.stat.products">Sản phẩm</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-slate-900">Beta</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider" data-i18n="hero.stat.workflow">Workflow Agent</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-slate-900">ROS 2</div>
            <div class="text-xs text-slate-400 uppercase tracking-wider" data-i18n="hero.stat.robot">Nền tảng Robot</div>
          </div>
        </div>
      </div>

      <!-- Right: Visual -->
      <div class="relative animate-fade-in" style="opacity:0;animation-fill-mode:forwards;animation-delay:0.4s" aria-hidden="true">
        <!-- Mock terminal / interface card -->
        <div class="relative">
          <!-- Glow behind card -->
          <div class="absolute -inset-4 bg-electric-600/10 rounded-2xl blur-xl"></div>

          <!-- Main card -->
          <div class="relative bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-lg">
            <!-- Window chrome -->
            <div class="flex items-center gap-2 px-4 py-3 bg-slate-50 border-b border-slate-200">
              <div class="w-3 h-3 rounded-full bg-red-400/80"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-400/80"></div>
              <div class="w-3 h-3 rounded-full bg-green-400/80"></div>
              <span class="ml-2 text-xs text-slate-400 font-mono" data-i18n="hero.terminal.title">workflow-agent • task runner</span>
            </div>

            <!-- Terminal content -->
            <div class="p-5 font-mono text-sm space-y-3">
              <div class="flex gap-2">
                <span class="text-electric-500">▶</span>
                <span class="text-slate-600"><span data-i18n="hero.terminal.task.label">Nhiệm vụ:</span> <span class="text-slate-900 font-medium" data-i18n="hero.terminal.task.text">Thu thập giá đối thủ từ 5 trang web</span></span>
              </div>
              <div class="pl-5 space-y-1.5 text-slate-500">
                <div class="flex items-center gap-2">
                  <span class="text-green-600">✓</span>
                  <span data-i18n="hero.terminal.step1">Đang mở trình duyệt...</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-green-600">✓</span>
                  <span data-i18n="hero.terminal.step2">Đang điều hướng đến trang 1/5...</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-green-600">✓</span>
                  <span data-i18n="hero.terminal.step3">Đang trích xuất bảng giá...</span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="text-electric-500 animate-pulse">◉</span>
                  <span class="text-electric-600" data-i18n="hero.terminal.step4">Đang xử lý trang 3/5...</span>
                </div>
              </div>
              <div class="flex gap-2 mt-2">
                <span class="text-spark-500">⚡</span>
                <span class="text-slate-500"><span data-i18n="hero.terminal.saving">Đang lưu vào</span> <span class="text-green-600">pricing-report.xlsx</span></span>
              </div>
            </div>

            <!-- Progress bar -->
            <div class="px-5 pb-5">
              <div class="flex justify-between text-xs text-slate-400 mb-1.5">
                <span data-i18n="hero.terminal.progress">Tiến độ</span>
                <span data-i18n="hero.terminal.progress.count">3/5 trang</span>
              </div>
              <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden">
                <div class="h-full bg-electric-gradient rounded-full w-3/5 transition-all duration-1000"></div>
              </div>
            </div>
          </div>

          <!-- Floating badge -->
          <div class="absolute -top-3 -right-3 bg-green-50 border border-green-200 rounded-full px-3 py-1 text-xs text-green-700 font-medium backdrop-blur-sm" data-i18n="hero.badge.local">
            Chạy cục bộ
          </div>
          <div class="absolute -bottom-3 -left-3 bg-blue-50 border border-blue-200 rounded-full px-3 py-1 text-xs text-blue-700 font-medium backdrop-blur-sm animate-float" data-i18n="hero.badge.ai">
            Hỗ trợ AI
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom gradient fade -->
  <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white to-transparent pointer-events-none" aria-hidden="true"></div>
</section>
