---
// Capabilities Section
const capabilities = [
  {
    icon: '⚡',
    title: 'Desktop & Web Automation',
    description: 'Automate any desktop app or browser task with AI. No scripting knowledge required.',
    href: '/solutions#desktop-automation',
    color: 'electric',
    video: '/videos/desktop-automation.mp4',
  },
  {
    icon: '🦾',
    title: 'Robotics Integration',
    description: 'ROS 2-based autonomous systems for navigation, manipulation, and sensing.',
    href: '/solutions#robotics',
    color: 'spark',
    video: '/videos/robotics.mp4',
  },
  {
    icon: '💬',
    title: 'Zalo AI Agents',
    description: 'Intelligent Zalo chatbots and AI agents for Vietnamese business workflows.',
    href: '/solutions#zalo-agents',
    color: 'cyan',
    video: '/videos/zalo-agents.mp4',
  },
  {
    icon: '🤖',
    title: 'AI Agents',
    description: 'Multi-step task planning and execution agents for complex real-world problems.',
    href: '/research/ai-agents',
    color: 'violet',
    video: '/videos/ai-agents.mp4',
  },
  {
    icon: '👁️',
    title: 'Computer Vision',
    description: 'Practical object detection, quality inspection, and scene understanding systems.',
    href: '/research/computer-vision',
    color: 'green',
    video: '/videos/computer-vision.mp4',
  },
  {
    icon: '🔬',
    title: 'Rapid Prototyping',
    description: 'From idea to working prototype fast — 3D printing, embedded systems, and more.',
    href: '/products/printing-3d-models',
    color: 'amber',
    video: '/videos/3d-printing.mp4',
  },
];
---

<section class="section bg-white relative overflow-hidden" id="capabilities">
  <!-- Divider top -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" aria-hidden="true"></div>

  <div class="container-wide relative z-10">
    <!-- Section Header (Left-aligned for a modern, clean look next to the wide slider) -->
    <div class="mb-10 lg:mb-12">
      <div class="section-label mb-4">
        <span data-i18n="cap.label">Năng lực</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black mb-4" data-i18n-html="cap.h2.html">
        Năng lực <span class="text-gradient-spark">cốt lõi</span>
      </h2>
      <p class="text-slate-500 text-lg max-w-2xl animate-fade-in" data-i18n="cap.sub">
        Nghiên cứu ứng dụng và sản phẩm thực tiễn bao gồm AI agent, robot và tự động hóa.
      </p>
    </div>

    <!-- Outer Slider Wrapper (relative, no overflow-hidden so nav buttons can float outside) -->
    <div class="relative max-w-5xl mx-auto px-1 md:px-0">
      
      <!-- Rounded slider container with overflow-hidden to crop slides -->
      <div class="w-full overflow-hidden rounded-[24px] shadow-lg hover:shadow-xl transition-shadow duration-500 border border-slate-100">
        <div 
          id="cap-slider-container" 
          class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth scrollbar-none"
        >
          {capabilities.map((cap, idx) => (
            <a
              href={cap.href}
              class="cap-card w-full flex-shrink-0 aspect-video snap-start relative group block"
            >
              <!-- Video Background -->
              <video 
                src={cap.video} 
                class="absolute inset-0 w-full h-full object-cover group-hover:scale-102 transition-transform duration-700 ease-out"
                autoplay
                muted
                loop
                playsinline
              ></video>

              <!-- Computer Vision AI Bounding Box overlay simulator -->
              {cap.color === 'green' && (
                <div class="absolute inset-0 z-10 pointer-events-none overflow-hidden">
                  <!-- Animated Bounding Box -->
                  <div class="absolute border-2 border-emerald-500 rounded bg-emerald-500/10 shadow-[0_0_15px_rgba(16,185,129,0.6)] animate-cv-box" style="left: 42%; top: 32%; width: 20%; height: 26%;">
                    <!-- Bounding box corners for high-tech look -->
                    <div class="absolute -top-0.5 -left-0.5 w-2.5 h-2.5 border-t-2 border-l-2 border-emerald-400"></div>
                    <div class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 border-t-2 border-r-2 border-emerald-400"></div>
                    <div class="absolute -bottom-0.5 -left-0.5 w-2.5 h-2.5 border-b-2 border-l-2 border-emerald-400"></div>
                    <div class="absolute -bottom-0.5 -right-0.5 w-2.5 h-2.5 border-b-2 border-r-2 border-emerald-400"></div>
                    
                    <!-- Detection status label tag -->
                    <div class="absolute -top-6 left-0 bg-emerald-500/90 backdrop-blur-sm text-white font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border border-emerald-400/30 flex items-center gap-1 shadow-md">
                      <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
                      <span>Tumor: 98.2%</span>
                    </div>
                  </div>
                  <!-- Laser Scan Line -->
                  <div class="absolute left-0 right-0 h-0.5 bg-gradient-to-r from-transparent via-emerald-400 to-transparent shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-cv-scan"></div>
                </div>
              )}
              
              <!-- Dark gradient overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/40 to-transparent opacity-90 transition-opacity duration-300"></div>
              
              <!-- Overlay content (bottom-left) -->
              <div class="absolute inset-0 p-6 md:p-12 flex flex-col justify-end text-white z-10 max-w-xl">
                <h3 
                  class="text-xl sm:text-2xl md:text-3xl font-black text-white mb-2 leading-tight group-hover:text-amber-300 transition-colors duration-300" 
                  data-i18n={`cap.${idx}.title`}
                >
                  {cap.title}
                </h3>
                
                <p 
                  class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6 max-w-lg" 
                  data-i18n={`cap.${idx}.desc`}
                >
                  {cap.description}
                </p>
                
                <div class="flex items-center gap-1.5 text-xs sm:text-sm text-amber-300 font-semibold transition-transform duration-300 group-hover:translate-x-1">
                  <span data-i18n="cap.learn.more">Tìm hiểu thêm</span>
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Navigation Buttons (glowing glassmorphic high-contrast slate style) -->
      <button 
        id="cap-prev-btn" 
        class="absolute left-2 md:-left-7 top-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-slate-900/90 text-white border border-slate-700/60 backdrop-blur-md flex items-center justify-center shadow-[0_4px_25px_rgba(0,0,0,0.35)] hover:bg-electric-600 hover:border-electric-400 hover:scale-110 active:scale-95 transition-all duration-300 z-20"
        aria-label="Previous slide"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      
      <button 
        id="cap-next-btn" 
        class="absolute right-2 md:-right-7 top-1/2 -translate-y-1/2 w-14 h-14 rounded-full bg-slate-900/90 text-white border border-slate-700/60 backdrop-blur-md flex items-center justify-center shadow-[0_4px_25px_rgba(0,0,0,0.35)] hover:bg-electric-600 hover:border-electric-400 hover:scale-110 active:scale-95 transition-all duration-300 z-20"
        aria-label="Next slide"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Divider bottom -->
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" aria-hidden="true"></div>
</section>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }

  /* Computer Vision Bounding Box Animations */
  .animate-cv-box {
    animation: cvBox 5s infinite ease-in-out;
  }
  .animate-cv-scan {
    animation: cvScan 3.5s infinite linear;
  }

  @keyframes cvBox {
    0%, 100% {
      transform: translate(0, 0) scale(1);
      border-color: #10b981;
      box-shadow: 0 0 15px rgba(16, 185, 129, 0.6);
    }
    30% {
      transform: translate(15px, -8px) scale(1.03);
      border-color: #34d399;
    }
    65% {
      transform: translate(-10px, 12px) scale(0.96);
      border-color: #f59e0b; /* Yellow warning shift */
      box-shadow: 0 0 15px rgba(245, 158, 11, 0.6);
    }
  }

  @keyframes cvScan {
    0% {
      top: 0%;
      opacity: 0;
    }
    15%, 85% {
      opacity: 1;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }
</style>

<script>
  function initCapabilitiesSlider() {
    const container = document.getElementById('cap-slider-container');
    const prevBtn = document.getElementById('cap-prev-btn');
    const nextBtn = document.getElementById('cap-next-btn');
    
    if (!container || !prevBtn || !nextBtn) return;
    
    prevBtn.addEventListener('click', () => {
      container.scrollBy({
        left: -container.clientWidth,
        behavior: 'smooth'
      });
    });
    
    nextBtn.addEventListener('click', () => {
      container.scrollBy({
        left: container.clientWidth,
        behavior: 'smooth'
      });
    });

    const toggleButtons = () => {
      const isStart = container.scrollLeft <= 10;
      const isEnd = container.scrollLeft + container.clientWidth >= container.scrollWidth - 10;
      
      prevBtn.style.opacity = isStart ? '0.35' : '1';
      prevBtn.style.pointerEvents = isStart ? 'none' : 'auto';
      
      nextBtn.style.opacity = isEnd ? '0.35' : '1';
      nextBtn.style.pointerEvents = isEnd ? 'none' : 'auto';
    };

    container.addEventListener('scroll', toggleButtons);
    // Initial check
    setTimeout(toggleButtons, 150);
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCapabilitiesSlider);
  } else {
    initCapabilitiesSlider();
  }
  
  // Listen for language switch transitions that might re-render or re-trigger components
  document.addEventListener('astro:after-swap', initCapabilitiesSlider);
</script>
