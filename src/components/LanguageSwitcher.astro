---
// LanguageSwitcher — renders the VI/EN toggle in the header
---

<button
  id="lang-switcher"
  class="lang-switcher"
  aria-label="Switch language"
  title="Chuyển ngôn ngữ / Switch language"
>
  <img id="lang-flag-img" class="lang-flag-img" src="/images/flag-vi.svg" alt="Vietnam Flag" />
  <span class="lang-code" id="lang-code">VI</span>
  <svg class="lang-chevron" fill="none" viewBox="0 0 10 6" aria-hidden="true">
    <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
  <!-- Tooltip -->
  <span class="lang-tooltip" id="lang-tooltip">Chuyển sang English</span>
</button>

<style>
  .lang-switcher {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.65rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(15, 23, 42, 0.12);
    background: white;
    cursor: pointer;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1E293B;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }
  .lang-switcher:hover {
    border-color: rgba(37, 99, 235, 0.35);
    background: #EFF6FF;
    box-shadow: 0 1px 4px rgba(37, 99, 235, 0.08);
  }
  .lang-flag-img {
    width: 1.05rem;
    height: 0.7rem;
    object-fit: cover;
    border-radius: 1px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.1);
    border: 1px solid rgba(0,0,0,0.06);
    flex-shrink: 0;
  }
  .lang-code {
    color: #1E293B;
    font-weight: 700;
  }
  .lang-chevron {
    width: 0.55rem;
    height: 0.55rem;
    color: #94A3B8;
    transition: transform 0.2s;
  }
  /* Tooltip */
  .lang-tooltip {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    background: #0F172A;
    color: white;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.3rem 0.6rem;
    border-radius: 0.4rem;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.15s, transform 0.15s;
    z-index: 100;
  }
  .lang-switcher:hover .lang-tooltip {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { vi } from '../i18n/vi';
  import { en } from '../i18n/en';

  const translations: Record<string, Record<string, string>> = { vi, en };

  /** Apply translations to all [data-i18n] and [data-i18n-html] elements */
  function applyTranslations(locale: string) {
    const t = translations[locale] ?? translations['vi'];

    // Text content
    document.querySelectorAll<HTMLElement>('[data-i18n]').forEach(el => {
      const key = el.dataset.i18n!;
      if (t[key] !== undefined) el.textContent = t[key];
    });

    // innerHTML (for elements with embedded spans/HTML)
    document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach(el => {
      const key = el.dataset.i18nHtml!;
      if (t[key] !== undefined) el.innerHTML = t[key];
    });

    // Placeholder attribute
    document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-i18n-placeholder]').forEach(el => {
      const key = (el as HTMLElement).dataset.i18nPlaceholder!;
      if (t[key] !== undefined) el.placeholder = t[key];
    });

    // aria-label attribute
    document.querySelectorAll<HTMLElement>('[data-i18n-aria]').forEach(el => {
      const key = el.dataset.i18nAria!;
      if (t[key] !== undefined) el.setAttribute('aria-label', t[key]);
    });

    // alt attribute (for images)
    document.querySelectorAll<HTMLImageElement>('[data-i18n-alt]').forEach(el => {
      const key = el.dataset.i18nAlt!;
      if (t[key] !== undefined) el.alt = t[key];
    });

    // Update <html lang>
    document.documentElement.lang = locale;
  }

  /** Update the switcher button UI */
  function updateSwitcherUI(locale: string) {
    const flagImg = document.getElementById('lang-flag-img') as HTMLImageElement | null;
    const code = document.getElementById('lang-code');
    const tooltip = document.getElementById('lang-tooltip');
    if (flagImg) {
      flagImg.src = locale === 'vi' ? '/images/flag-vi.svg' : '/images/flag-en.svg';
      flagImg.alt = locale === 'vi' ? 'Vietnam Flag' : 'US Flag';
    }
    if (code) code.textContent = locale === 'vi' ? 'VI' : 'EN';
    if (tooltip) tooltip.textContent = locale === 'vi' ? 'Switch to English' : 'Chuyển sang Tiếng Việt';
  }

  // On DOMContentLoaded — apply stored language preference
  function init() {
    const saved = localStorage.getItem('arl-lang') || 'vi';
    applyTranslations(saved);
    updateSwitcherUI(saved);

    const btn = document.getElementById('lang-switcher');
    btn?.addEventListener('click', () => {
      const current = localStorage.getItem('arl-lang') || 'vi';
      const next = current === 'vi' ? 'en' : 'vi';
      localStorage.setItem('arl-lang', next);
      applyTranslations(next);
      updateSwitcherUI(next);

      // Smooth flash feedback
      btn.style.transform = 'scale(0.92)';
      setTimeout(() => { btn.style.transform = ''; }, 150);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
