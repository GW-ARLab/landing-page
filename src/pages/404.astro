---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" noIndex>
  <section class="min-h-[70vh] flex items-center justify-center bg-navy-900 relative overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern opacity-50" aria-hidden="true"></div>
    <div class="glow-blue w-[400px] h-[400px] top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 opacity-15" aria-hidden="true"></div>

    <div class="container-narrow relative z-10 text-center py-20">
      <div class="text-8xl font-black text-gradient-electric mb-4" aria-hidden="true">404</div>
      <h1 class="text-3xl sm:text-4xl font-black mb-4 text-slate-900" data-i18n="page404.title">Page not found</h1>
      <p class="text-slate-600 text-lg mb-10" data-i18n="page404.desc">
        This page doesn't exist — or was moved. Try navigating from the menu above.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="btn-primary btn-lg" data-i18n="page404.cta.home">Go Home</a>
        <a href="/products" class="btn-outline btn-lg" data-i18n="page404.cta.products">View Products</a>
        <a href="/contact" class="btn-ghost btn-lg" data-i18n="page404.cta.contact">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>
