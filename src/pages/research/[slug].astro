---
import PageLayout from '@/layouts/PageLayout.astro';
import { getPublishedResearch, researchTypeLabel, formatDate, researchSlug } from '@/lib/content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const { getPublishedResearch, researchSlug } = await import('@/lib/content');
  const items = await getPublishedResearch();
  return items.map((item) => ({
    params: { slug: researchSlug(item) },
    props: { item },
  }));
};

const { item } = Astro.props;
const { Content } = await item.render();

const typeBadgeColors: Record<string, string> = {
  'research-area': 'text-violet-700 bg-violet-50 border-violet-200',
  project: 'text-electric-700 bg-electric-50 border-electric-200',
  publication: 'text-green-700 bg-green-50 border-green-200',
  'technical-article': 'text-amber-700 bg-amber-50 border-amber-200',
  'open-source': 'text-cyan-700 bg-cyan-50 border-cyan-200',
};
---

<PageLayout
  title={item.data.seo.title}
  description={item.data.seo.description}
  ogImage={item.data.ogImage}
  breadcrumbs={[
    { label: 'Research', href: '/research', i18nKey: 'nav.research' },
    { label: item.data.title, href: `/research/${researchSlug(item)}`, i18nKey: `research.${researchSlug(item)}.title` },
  ]}
>
  <!-- Article Header -->
  <section class="relative py-16 lg:py-20 bg-navy-900 overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern opacity-50" aria-hidden="true"></div>
    <div class="glow-blue w-[400px] h-[400px] top-0 left-1/3 opacity-20" aria-hidden="true"></div>

    <div class="container-narrow relative z-10">
      <!-- Meta row -->
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span 
          data-i18n={`research.type.${item.data.type}`}
          class:list={['badge', typeBadgeColors[item.data.type] ?? typeBadgeColors.project]}
        >
          {researchTypeLabel(item.data.type)}
        </span>
        <span class="badge badge-available">{item.data.status}</span>
        {item.data.publishedAt && (
          <span class="text-xs text-slate-500">{formatDate(item.data.publishedAt)}</span>
        )}
      </div>

      <h1 
        class="text-4xl sm:text-5xl font-black mb-5 leading-tight text-slate-900"
        data-i18n={`research.${researchSlug(item)}.title`}
      >
        {item.data.title}
      </h1>
      <p 
        class="text-xl text-slate-600 leading-relaxed mb-6"
        data-i18n={`research.${researchSlug(item)}.summary`}
      >
        {item.data.summary}
      </p>

      <!-- Authors -->
      {item.data.authors.length > 0 && (
        <div class="text-sm text-slate-500 mb-6">
          By {item.data.authors.join(', ')}
          {item.data.updatedAt && (
            <span> · Updated {formatDate(item.data.updatedAt)}</span>
          )}
        </div>
      )}

      <!-- Topics -->
      <div class="flex flex-wrap gap-2 mb-8">
        {item.data.topics.map((topic) => (
          <span 
            data-i18n={`research.topic.${topic}`}
            class="text-sm px-3 py-1 rounded-full bg-white border border-slate-200 text-slate-600"
          >
            #{topic}
          </span>
        ))}
      </div>

      <!-- Action links -->
      <div class="flex flex-wrap gap-3">
        {item.data.repositoryUrl && (
          <a href={item.data.repositoryUrl} target="_blank" rel="noopener noreferrer" class="btn-outline btn-sm">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
            <span data-i18n="research.detail.github">View on GitHub</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        )}
        {item.data.publicationUrl && (
          <a href={item.data.publicationUrl} target="_blank" rel="noopener noreferrer" class="btn-outline btn-sm">
            <span data-i18n="research.detail.read-pub">Read Publication</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        )}
        {item.data.demoUrl && (
          <a href={item.data.demoUrl} class="btn-primary btn-sm" data-i18n="research.detail.view-demo">View Demo</a>
        )}
      </div>
    </div>
  </section>

  <!-- Publication details -->
  {item.data.publication && (
    <section class="py-8 bg-navy-800/30 border-t border-electric-500/10">
      <div class="container-narrow">
        <div class="bg-white border border-slate-200 rounded-xl p-5">
          <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-wider mb-3" data-i18n="research.detail.pub-details">Publication Details</h2>
          <div class="space-y-2 text-sm">
            {item.data.publication.venue && (
              <div class="flex gap-2">
                <span class="text-slate-500 w-20 flex-shrink-0" data-i18n="research.detail.venue">Venue</span>
                <span class="text-slate-700">{item.data.publication.venue}</span>
              </div>
            )}
            {item.data.publication.year && (
              <div class="flex gap-2">
                <span class="text-slate-500 w-20 flex-shrink-0" data-i18n="research.detail.year">Year</span>
                <span class="text-slate-700">{item.data.publication.year}</span>
              </div>
            )}
            {item.data.publication.citation && (
              <div class="flex gap-2">
                <span class="text-slate-500 w-20 flex-shrink-0" data-i18n="research.detail.citation">Citation</span>
                <span class="text-slate-700 font-mono text-xs bg-slate-100 px-2 py-1 rounded">{item.data.publication.citation}</span>
              </div>
            )}
            {item.data.publication.pdfUrl && (
              <a href={item.data.publication.pdfUrl} class="inline-flex items-center gap-1.5 text-electric-400 hover:text-electric-300 text-xs mt-1" target="_blank" rel="noopener noreferrer">
                <span data-i18n="research.detail.download-pdf">Download PDF</span>
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Main content -->
  <section class="section bg-navy-900">
    <div class="container-narrow">
      <div class="prose-arl">
        <Content />
      </div>
    </div>
  </section>

  <!-- Related products -->
  {item.data.relatedProducts.length > 0 && (
    <section class="py-12 bg-navy-800/30 border-t border-electric-500/10">
      <div class="container-narrow">
        <h2 class="text-xl font-bold text-slate-900 mb-5" data-i18n="research.detail.related-products">Related Products</h2>
        <div class="flex flex-wrap gap-3">
          {item.data.relatedProducts.map((slug) => (
            <a href={`/products/${slug}`} class="btn-outline btn-sm">
              <span data-i18n="solutions.see.product">See</span> <span data-i18n={`product.${slug}.name`}>{slug.replace(/-/g, ' ')}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Collaboration CTA -->
  <section class="py-12 bg-navy-900 border-t border-electric-500/10">
    <div class="container-narrow text-center">
      <h2 class="text-2xl font-bold text-slate-900 mb-3" data-i18n="research.detail.collab.title">Interested in collaborating on this research?</h2>
      <a href="/contact?type=research-collaboration" class="btn-primary" data-i18n="research.detail.collab.cta">
        Research Collaboration Inquiry
      </a>
    </div>
  </section>
</PageLayout>
