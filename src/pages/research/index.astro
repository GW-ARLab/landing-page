---
import PageLayout from '@/layouts/PageLayout.astro';
import { getPublishedResearch, researchTypeLabel, researchSlug } from '@/lib/content';

const allResearch = await getPublishedResearch();

const types = [
  { value: 'all', label: 'All' },
  { value: 'research-area', label: 'Research Areas' },
  { value: 'project', label: 'Projects' },
  { value: 'publication', label: 'Publications' },
  { value: 'technical-article', label: 'Articles' },
  { value: 'open-source', label: 'Open Source' },
];

const typeBadgeColors: Record<string, string> = {
  'research-area': 'text-violet-700 bg-violet-50 border-violet-200',
  project: 'text-electric-700 bg-electric-50 border-electric-200',
  publication: 'text-green-700 bg-green-50 border-green-200',
  'technical-article': 'text-amber-700 bg-amber-50 border-amber-200',
  'open-source': 'text-cyan-700 bg-cyan-50 border-cyan-200',
};
---

<PageLayout
  title="Research"
  description="ARL research areas, active projects, publications, and open-source contributions in AI agents, robotics, and computer vision."
  breadcrumbs={[{ label: 'Research', href: '/research', i18nKey: 'nav.research' }]}
>
  <!-- Hero -->
  <section class="relative py-16 lg:py-24 bg-navy-900 overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern opacity-50" aria-hidden="true"></div>
    <div class="glow-blue w-[500px] h-[500px] top-0 right-0 opacity-20" aria-hidden="true"></div>

    <div class="container-wide relative z-10">
      <div class="max-w-2xl">
        <div class="section-label mb-4"><span data-i18n="research.hero.label">Research</span></div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black mb-6" data-i18n-html="research.hero.h1.html">
          Applied research,<br />
          <span class="text-gradient-electric">real impact</span>
        </h1>
        <p class="text-xl text-slate-600 leading-relaxed" data-i18n="research.hero.desc">
          Our research directly informs the products we build — from AI agent architectures
          to autonomous navigation systems deployed on real hardware.
        </p>
      </div>
    </div>
  </section>

  <!-- Research list -->
  <section class="section bg-navy-900">
    <div class="container-wide">
      <!-- Type filter -->
      <div class="flex flex-wrap gap-2 mb-10" role="group" aria-label="Filter by type">
        {types.map((t) => (
          <button
            data-type={t.value}
            data-i18n={`research.filter.${t.value}`}
            class:list={[
              'px-4 py-1.5 rounded-full text-sm font-medium border transition-all duration-200',
              t.value === 'all'
                ? 'bg-electric-600 border-electric-500 text-white'
                : 'bg-transparent border-slate-300 text-slate-600 hover:text-electric-600 hover:border-electric-500',
            ]}
            aria-pressed={t.value === 'all' ? 'true' : 'false'}
          >
            {t.label}
          </button>
        ))}
      </div>

      <!-- Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5" id="research-grid">
        {allResearch.map((item) => (
          <article
            class="card group flex flex-col relative"
            data-type={item.data.type}
          >
            <!-- Type badge -->
            <div 
              data-i18n={`research.type.${item.data.type}`}
              class:list={['badge mb-4 self-start', typeBadgeColors[item.data.type] ?? typeBadgeColors.project]}
            >
              {researchTypeLabel(item.data.type)}
            </div>

            <h2 class="text-lg font-bold text-slate-900 group-hover:text-electric-600 transition-colors mb-2 flex-1">
              <a 
                href={`/research/${researchSlug(item)}`} 
                class="after:absolute after:inset-0 after:rounded-xl"
                data-i18n={`research.${researchSlug(item)}.title`}
              >
                {item.data.title}
              </a>
            </h2>

            <p 
              class="text-slate-600 text-sm leading-relaxed mb-4 line-clamp-3"
              data-i18n={`research.${researchSlug(item)}.summary`}
            >
              {item.data.summary}
            </p>

            <!-- Authors -->
            {item.data.authors.length > 0 && (
              <div class="text-xs text-slate-500 mb-3">
                {item.data.authors.join(', ')}
              </div>
            )}

            <!-- Topics -->
            <div class="flex flex-wrap gap-1.5 mt-auto pt-3 border-t border-slate-100">
              {item.data.topics.slice(0, 3).map((topic) => (
                <span 
                  data-i18n={`research.topic.${topic}`}
                  class="text-xs text-slate-600 px-2 py-0.5 rounded bg-slate-100 border border-slate-200"
                >
                  {topic}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Collaboration CTA -->
  <section class="py-16 bg-navy-800/30 border-t border-electric-500/10">
    <div class="container-narrow text-center">
      <h2 class="text-3xl font-black mb-4 text-slate-900" data-i18n="research.footer.h2">Interested in collaborating?</h2>
      <p class="text-slate-600 mb-8" data-i18n="research.footer.desc">
        We welcome research partnerships with universities, labs, and industry partners.
      </p>
      <a 
        href="/contact?type=research-collaboration" 
        class="btn-primary btn-lg"
        data-i18n="research.footer.cta"
      >
        Research Collaboration Inquiry
      </a>
    </div>
  </section>
</PageLayout>

<script>
  const btns = document.querySelectorAll('[data-type]');
  const cards = document.querySelectorAll<HTMLElement>('[data-type]:not(button)');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const type = (btn as HTMLElement).dataset.type ?? 'all';
      btns.forEach((b) => {
        const isActive = (b as HTMLElement).dataset.type === type;
        b.classList.toggle('bg-electric-600', isActive);
        b.classList.toggle('border-electric-500', isActive);
        b.classList.toggle('text-white', isActive);
        b.classList.toggle('bg-transparent', !isActive);
        b.classList.toggle('border-slate-300', !isActive);
        b.classList.toggle('text-slate-600', !isActive);
        b.setAttribute('aria-pressed', String(isActive));
      });
      cards.forEach((card) => {
        const show = type === 'all' || card.dataset.type === type;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
