---
import PageLayout from '@/layouts/PageLayout.astro';
import { siteConfig } from '@/lib/site';
---

<PageLayout
  title="About"
  description="Applied Robotics Lab — building AI automation tools and robotic systems. Our mission, team, and research philosophy."
  breadcrumbs={[{ label: 'About', href: '/about', i18nKey: 'about.title' }]}
>
  <!-- Hero -->
  <section class="relative py-16 lg:py-24 bg-slate-50/50 overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern opacity-50" aria-hidden="true"></div>
    <div class="glow-blue w-[500px] h-[500px] top-0 right-0 opacity-20" aria-hidden="true"></div>

    <div class="container-wide relative z-10">
      <div class="max-w-3xl">
        <div class="section-label mb-4"><span data-i18n="about.hero.label">About ARL</span></div>
        <h1 
          class="text-4xl sm:text-5xl lg:text-6xl font-black mb-6 leading-tight text-slate-900"
          data-i18n-html="about.hero.h1.html"
        >
          We build systems<br />
          that <span class="text-gradient-electric">work in the world</span>,<br />
          not just in demos.
        </h1>
        <p 
          class="text-xl text-slate-600 leading-relaxed"
          data-i18n="about.hero.desc"
        >
          Applied Robotics Lab was founded with a single belief: the gap between 
          cutting-edge AI/robotics research and practical, deployable products is 
          too wide — and we're here to close it.
        </p>
      </div>
    </div>
  </section>

  <!-- Mission & Vision -->
  <section class="section bg-slate-100/30">
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-electric-500/25 to-transparent" aria-hidden="true"></div>
    <div class="container-wide">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          {
            label: 'Mission',
            icon: '🎯',
            i18nLabel: 'about.mission.label',
            i18nContent: 'about.mission.desc',
            content: 'Build intelligent automation tools and robotic systems that genuinely improve how people work — accessible to both technical teams and non-technical users.',
          },
          {
            label: 'Vision',
            icon: '🔭',
            i18nLabel: 'about.vision.label',
            i18nContent: 'about.vision.desc',
            content: 'A world where AI and robots handle the repetitive, dangerous, and tedious — freeing humans for creative, strategic, and meaningful work.',
          },
          {
            label: 'Philosophy',
            icon: '⚗️',
            i18nLabel: 'about.philosophy.label',
            i18nContent: 'about.philosophy.desc',
            content: 'Ship working things. Start with real problems. Iterate fast. Stay close to users. Research only matters if it becomes reality.',
          },
        ].map((item) => (
          <div class="card bg-white border border-slate-200">
            <div class="text-3xl mb-4" aria-hidden="true">{item.icon}</div>
            <h2 class="text-sm font-semibold text-slate-500 uppercase tracking-widest mb-3" data-i18n={item.i18nLabel}>{item.label}</h2>
            <p class="text-slate-600 leading-relaxed" data-i18n={item.i18nContent}>{item.content}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we do -->
  <section class="section bg-white">
    <div class="container-wide">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        <div>
          <div class="section-label mb-4"><span data-i18n="about.whatwedo.label">What We Do</span></div>
          <h2 class="text-3xl sm:text-4xl font-black mb-5 text-slate-900" data-i18n-html="about.whatwedo.h2.html">
            Products, research,<br />
            and <span class="text-gradient-spark">everything in between</span>
          </h2>
          <p class="text-slate-600 leading-relaxed mb-6" data-i18n="about.whatwedo.desc">
            ARL operates at the intersection of applied research and product development.
            We run an active research program in AI agents, computer vision, and autonomous 
            navigation — and we turn that research into products and services our clients use today.
          </p>
          <p class="text-slate-600 leading-relaxed mb-8" data-i18n="about.whatwedo.focus.label">
            Our focus areas:
          </p>
          <ul class="space-y-3">
            {[
              'AI-powered desktop and web automation',
              'Autonomous mobile robotics (ROS 2)',
              'Computer vision for inspection and navigation',
              'Zalo AI agents for Vietnamese businesses',
              '3D printing for rapid robotics prototyping',
            ].map((item, idx) => (
              <li class="flex items-center gap-3 text-slate-700">
                <div class="w-5 h-5 rounded-full bg-electric-50 flex items-center justify-center flex-shrink-0">
                  <svg class="w-3 h-3 text-electric-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span data-i18n={`about.whatwedo.focus.${idx}`}>{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Lab visual -->
        <div>
          <div class="rounded-2xl border border-slate-200 aspect-video overflow-hidden relative shadow-md">
            <img 
              src="/images/about_lab_visual.png" 
              alt="Applied Robotics Lab research workspace showing robotic arm testing and electronics setup"
              class="w-full h-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Profiles -->
  <section class="section bg-slate-50/50 border-t border-slate-200">
    <div class="container-wide">
      <div class="text-center mb-10">
        <div class="section-label justify-center mb-3"><span data-i18n="about.team.label">Team</span></div>
        <h2 class="text-3xl sm:text-4xl font-black text-slate-900" data-i18n="about.team.h2">The people behind ARL</h2>
        <p class="text-slate-500 mt-2 max-w-xl mx-auto" data-i18n="about.team.desc">Our research and engineering team bridges the gap between scientific theory and deployable products.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
        {[
          {
            name: 'Dr. Anh Nguyen',
            role: 'Founder & Research Director',
            bio: 'Lead researcher in AI systems and reinforcement learning. Formerly post-doc at leading robotics laboratories.',
            specialty: 'AI Agents & Decision Systems',
            emoji: '👨‍🔬',
            idx: 0
          },
          {
            name: 'Bao Tran',
            role: 'Lead Robotics Engineer',
            bio: 'ROS 2 specialist and hardware systems developer. Over 6 years design experience building autonomous mobile robots.',
            specialty: 'Autonomous Navigation & Kinematics',
            emoji: '🦾',
            idx: 1
          },
          {
            name: 'Linh Pham',
            role: 'Senior Software Engineer',
            bio: 'Fullstack developer specializing in real-time control panels and high-performance desktop orchestration systems.',
            specialty: 'Control Interfaces & Web Platforms',
            emoji: '👩‍💻',
            idx: 2
          },
          {
            name: 'Huy Nguyen',
            role: 'IoT Team Lead',
            bio: 'Specialist in IoT architectures, embedded systems, and sensor networks. Over 5 years of experience connecting physical devices to cloud platforms.',
            specialty: 'IoT Systems & Embedded Hardware',
            emoji: '📡',
            idx: 3
          }
        ].map((member) => (
          <div class="card flex flex-col items-center text-center">
            <div class="w-16 h-16 rounded-2xl bg-electric-50 border border-electric-100 flex items-center justify-center text-3xl mb-4">
              {member.emoji}
            </div>
            <h3 class="text-lg font-bold text-slate-900 mb-1" data-i18n={`about.team.${member.idx}.name`}>{member.name}</h3>
            <p class="text-xs font-semibold text-electric-600 uppercase tracking-wider mb-3" data-i18n={`about.team.${member.idx}.role`}>{member.role}</p>
            <p class="text-sm text-slate-600 leading-relaxed mb-4 flex-1" data-i18n={`about.team.${member.idx}.bio`}>{member.bio}</p>
            <span class="text-xs px-2.5 py-1 rounded bg-slate-100 border border-slate-200 text-slate-500 font-medium" data-i18n={`about.team.${member.idx}.specialty`}>
              {member.specialty}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Collaboration CTA -->
  <section class="py-16 bg-slate-50 border-t border-slate-200">
    <div class="container-narrow text-center">
      <h2 class="text-3xl font-black text-slate-900 mb-4" data-i18n="about.work.h2">Work with ARL</h2>
      <p class="text-slate-600 mb-8" data-i18n="about.work.desc">
        Interested in research collaboration, product partnerships, or just want to say hi?
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact?type=partnership" class="btn-primary btn-lg" data-i18n="about.work.cta.partnership">Partnership Inquiry</a>
        <a href="/contact?type=research-collaboration" class="btn-outline btn-lg" data-i18n="about.work.cta.research">Research Collaboration</a>
      </div>
    </div>
  </section>
</PageLayout>
